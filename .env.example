# Copier vers .env
# "localhost" => certificat auto-signé local. Un vrai domaine => Let's Encrypt automatique
DOMAIN=localhost
ACME_EMAIL=you@example.com

# Chatbot (LangGraph)
ANTHROPIC_API_KEY=sk-ant-...
CHATBOT_MODEL=claude-sonnet-5-5

# Stripe : utilise une CLÉ RESTREINTE (rk_...) plutôt qu'une clé secrète (sk_...), en sandbox/test d'abord.
# Permissions minimales : Checkout Sessions (écriture + lecture). Ne jamais committer de clé live.
STRIPE_SECRET_KEY=rk_test_...
# Secret du webhook : "stripe listen" en local, ou Dashboard > Développeurs > Webhooks en production
STRIPE_WEBHOOK_SECRET=whsec_...

# Base de données MySQL (changer les mots de passe en production)
MYSQL_DATABASE=kozz
MYSQL_USER=kozz
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Yesim (fournisseur eSIM) : jeton du panneau partenaire core.yesim.biz > API token. Secret : ne jamais committer.
YESIM_API_TOKEN=
YESIM_BASE_URL=https://partners-api.yesim.biz

# --- Identité légale du vendeur (OBLIGATOIRE sur chaque facture et dans les mentions légales) ---
# Tant que ces champs ne sont pas renseignés (société immatriculée), aucune facture n'est émise.
SELLER_NAME=
SELLER_LEGAL_FORM=SAS
SELLER_CAPITAL=
SELLER_ADDRESS=
SELLER_SIREN=
SELLER_RCS=
SELLER_VAT_NUMBER=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_PUBLISHER=
SELLER_MEDIATOR=
HOST_NAME=
HOST_ADDRESS=
VAT_RATE=20
# true seulement si la société est en franchise en base de TVA (mention art. 293 B du CGI sur la facture)
VAT_FRANCHISE=false
TERMS_VERSION=2026-10

# --- E-mail (SMTP : Brevo, Amazon SES, Postmark, OVH, etc.) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KozzGo <commande@ton-domaine.fr>
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=KozzGo
# false = le SMS contient seulement un lien sécurisé ; true = ajoute aussi le code d'activation (déconseillé : un SMS peut être intercepté)
SMS_INCLUDE_ACTIVATION_CODE=false
# Confirmations de commande par SMS. false (défaut) = e-mail UNIQUEMENT (facture, QR code, installation). À passer à true avec un compte Twilio payant.
SMS_NOTIFICATIONS_ENABLED=false
# A2F par SMS : le filleul doit vérifier son numéro (code à 6 chiffres) pour débloquer les crédits de parrainage (1 numéro = 1 compte).
# false (défaut) = parrainage sans vérification de téléphone. À passer à true UNIQUEMENT avec un compte Twilio payant :
# un compte d'essai n'envoie de SMS qu'à des numéros préalablement vérifiés chez Twilio.
PHONE_VERIFICATION_ENABLED=false

# Firsty (fournisseur d'eSIM) : sandbox https://connect.test.firsty.app/api/v3, production https://connect.firsty.app/api/v3
# ESIM_PROVIDER=firsty|yesim (par défaut : Firsty s'il est configuré)
FIRSTY_BASE_URL=https://connect.test.firsty.app/api/v3
FIRSTY_CLIENT_ID=
FIRSTY_CLIENT_SECRET=

# Mettre true UNIQUEMENT pour des tests : envoie l'e-mail même sans facture (non conforme en production)
# ALLOW_EMAIL_WITHOUT_INVOICE=false

# Vérification de l'e-mail à l'inscription (code à 6 chiffres). false = le compte est créé directement, sans code.
EMAIL_VERIFICATION_ENABLED=true

# Récapitulatif des dons (page d'accueil) : ignorer les commandes antérieures à cette date (AAAA-MM-JJ). Vide = tout compter.
IMPACT_COUNT_FROM=

# Paiement en devises : taux du jour (BCE + Exchange Rate API), mis à jour toutes les FX_SYNC_HOURS heures
FX_SYNC_HOURS=24
# Marge ajoutée au taux pour couvrir les frais de conversion de Stripe (environ 2 %). 0 = aucun.
FX_MARGIN_PCT=2
