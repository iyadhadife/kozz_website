{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# En-têtes de sécurité. Le paiement se fait sur checkout.stripe.com (redirection) : aucun script Stripe sur nos pages.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Robots qui n'exécutent pas (ou mal) le JavaScript : IA, Bing, DuckDuckGo, Yandex, Baidu, Apple. Ils reçoivent l'instantané HTML RENDU de la page
	# (même contenu que les visiteurs ; généré par scripts/prerender.mjs). Googlebot exécute le JS : il reste sur la SPA.
	@bot_home {
		header_regexp User-Agent (?i)(gptbot|chatgpt-user|oai-searchbot|claudebot|claude-user|claude-searchbot|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|duckassistbot|meta-externalagent|cohere-ai|diffbot|youbot|bingbot|duckduckbot|yandexbot|baiduspider|applebot)
		path /
	}
	handle @bot_home {
		rewrite * /__prerender/index.html
		reverse_proxy frontend:80
	}
	@bot_pages {
		header_regexp User-Agent (?i)(gptbot|chatgpt-user|oai-searchbot|claudebot|claude-user|claude-searchbot|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|duckassistbot|meta-externalagent|cohere-ai|diffbot|youbot|bingbot|duckduckbot|yandexbot|baiduspider|applebot)
		path /destinations /destinations/* /faq /impact /comment-ca-marche /kozz-monde /telephones-compatibles /devenir-partenaire /cgv /mentions-legales /confidentialite /retractation /remboursement
	}
	handle @bot_pages {
		rewrite * /__prerender{path}.html
		reverse_proxy frontend:80
	}

	# Robots d'aperçu de liens (WhatsApp, iMessage, Slack, X, LinkedIn, Facebook, Telegram, Discord ; pas les moteurs de recherche, qui exécutent le JS) : balises Open Graph
	# rendues côté serveur pour l'accueil, les fiches destination et les passeports partagés. Les humains ne passent jamais par là.
	@crawler_home {
		header_regexp User-Agent (?i)(facebookexternalhit|whatsapp|twitterbot|slackbot|telegrambot|linkedinbot|discordbot|skypeuripreview|pinterest)
		path /
	}
	handle @crawler_home {
		rewrite * /api/og/home?{query}
		reverse_proxy backend:8000
	}
	@crawler {
		header_regexp User-Agent (?i)(facebookexternalhit|whatsapp|twitterbot|slackbot|telegrambot|linkedinbot|discordbot|skypeuripreview|pinterest)
		path /passeport/* /destinations/*
	}
	handle @crawler {
		rewrite * /api/og{path}
		reverse_proxy backend:8000
	}

	# sitemap.xml et robots.txt générés par le backend (liste des destinations à jour, adresse du site depuis .env)
	handle /llms.txt {
		rewrite * /api/seo/llms.txt
		reverse_proxy backend:8000
	}
	handle /sitemap.xml {
		rewrite * /api/seo/sitemap.xml
		reverse_proxy backend:8000
	}
	handle /robots.txt {
		rewrite * /api/seo/robots.txt
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /chat/* {
		uri strip_prefix /chat
		reverse_proxy chatbot:8001 {
			flush_interval -1   # streaming des réponses
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
