{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# En-têtes de sécurité. Le paiement se fait sur checkout.stripe.com (redirection) : aucun script Stripe sur nos pages.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Robots d'aperçu de liens (WhatsApp, iMessage, Slack, X, LinkedIn, Facebook, Telegram, Discord ; pas les moteurs de recherche, qui exécutent le JS) : balises Open Graph
	# rendues côté serveur pour l'accueil, les fiches destination et les passeports partagés. Les humains ne passent jamais par là.
	@crawler_home {
		header_regexp User-Agent (?i)(facebookexternalhit|whatsapp|twitterbot|slackbot|telegrambot|linkedinbot|discordbot|skypeuripreview|pinterest)
		path /
	}
	handle @crawler_home {
		rewrite * /api/og/home?{query}
		reverse_proxy backend:8000
	}
	@crawler {
		header_regexp User-Agent (?i)(facebookexternalhit|whatsapp|twitterbot|slackbot|telegrambot|linkedinbot|discordbot|skypeuripreview|pinterest)
		path /passeport/* /destinations/*
	}
	handle @crawler {
		rewrite * /api/og{path}
		reverse_proxy backend:8000
	}

	# sitemap.xml et robots.txt générés par le backend (liste des destinations à jour, adresse du site depuis .env)
	handle /sitemap.xml {
		rewrite * /api/seo/sitemap.xml
		reverse_proxy backend:8000
	}
	handle /robots.txt {
		rewrite * /api/seo/robots.txt
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /chat/* {
		uri strip_prefix /chat
		reverse_proxy chatbot:8001 {
			flush_interval -1   # streaming des réponses
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
